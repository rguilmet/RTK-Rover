{
  "description": "Local secret patterns and tokens for pre-push and security verification. Copy this file to .secrets.local and customize with your private tokens. Do NOT commit .secrets.local to git.",
  "forbidden_tokens": [
    "MY_AMATEUR_CALLSIGN",
    "MY_PRIVATE_BASESTATION_HOSTNAME",
    "MY_LATTITUDE",
    "MY_LONGITUDE",
    "MyPrivateWiFiPass"
  ],
  "forbidden_patterns": [
    {
      "pattern": "MyPrivateStreet\\s+Name",
      "description": "Private street address pattern",
      "case_insensitive": true
    },
    {
      "pattern": "MyPrivateTown\\s+State",
      "description": "Private town and state reference",
      "case_insensitive": true
    }
  ],
  "forbidden_filenames": [
    "secrets.local"
  ]
}
